# ====================================================================
# Self-Hosted LLM Infrastructure - Environment Template
# Copy to .env and fill in values. Never commit .env.
# ====================================================================

# --- Bridge ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
BRIDGE_SECRET_KEY=change-me-use-openssl-rand-hex-32
BRIDGE_LOG_LEVEL=INFO
BRIDGE_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Database ---
POSTGRES_USER=llm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llm_infra
DATABASE_URL=postgresql+asyncpg://llm:change-me@postgres:5432/llm_infra

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Local Ollama (preprocessor) ---
OLLAMA_LOCAL_URL=http://ollama:11434
OLLAMA_PREPROCESSOR_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Pipeline stages run per-request unless overridden by X-Pipeline header or user setting.
#   infer                       — direct GPU inference (default, no local model used)
#   preprocess,infer            — local 7B rewrites prompt first, then GPU infers
#   preprocess,infer,postprocess — adds local critic/formatter pass after GPU response
PIPELINE_DEFAULT=infer

# --- GPU Providers ---
# PROVIDER_PRIORITY controls order and which providers are tried. Only providers with a key set
# (or no key required) are active. Comma-separated. Available: runpod,vast,lambda,local,openai,groq,together,mistral,deepseek
PROVIDER_PRIORITY=runpod,vast,lambda
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=   # optional; create once in RunPod dashboard → Storage → Network Volumes
VAST_API_KEY=
LAMBDA_API_KEY=
# Set to 1 to use local Ollama as a fake provider (smoke tests, no GPU billing)
MOCK_PROVIDERS=false

# --- Local GPU (no cloud required) ---
# Add "local" to PROVIDER_PRIORITY to route to the Ollama instance on this machine.
# Requires NVIDIA GPU and the ollama service running (remove GPU reservation from docker-compose for CPU-only).
# Example: PROVIDER_PRIORITY=local
# No extra vars needed — uses OLLAMA_LOCAL_URL above.

# --- Commercial API providers (OpenAI-compatible, no pod lifecycle) ---
# Add provider name to PROVIDER_PRIORITY to enable. Example: PROVIDER_PRIORITY=openai,runpod
OPENAI_API_KEY=
OPENAI_MODEL_SIMPLE=          # default: gpt-4o-mini
OPENAI_MODEL_ARCHITECTURE=    # default: gpt-4o
OPENAI_MODEL_MAXIMUM=         # default: gpt-4o
OPENAI_MODEL_ULTRA=           # default: gpt-4o
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Pooling / Reaper ---
IDLE_REAPER_INTERVAL_SEC=30
COLD_START_TIMEOUT_SEC=180
HEALTH_CHECK_INTERVAL_SEC=30
HEALTH_CHECK_FAIL_THRESHOLD=3

# --- Billing / Quotas (defaults for new users) ---
BUDGET_DEFAULT_USD=25.00
BUDGET_ALERT_PERCENTS=50,80,100
RATE_LIMIT_RPM_DEFAULT=60
TOKENS_PER_DAY_DEFAULT=1000000
BILLING_MODE_DEFAULT=postpaid

# --- Open WebUI ---
OPENWEBUI_SECRET_KEY=change-me
OPENWEBUI_BRIDGE_URL=http://bridge:8000

# --- Dashboard ---
DASHBOARD_PORT=8501
